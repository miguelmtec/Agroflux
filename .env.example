# Ao criar o banco Postgres pela Vercel (Storage > Create Database > Postgres)
# e conectar ao projeto, a Vercel injeta a POSTGRES_URL sozinha em produção.
#
# Para rodar/testar na sua máquina, gere um arquivo .env.local com:
#   vercel env pull .env.local
# (depois de rodar "vercel link" uma vez na pasta do projeto)
#
# JWT_SECRET você define: qualquer texto longo e aleatório, ex:
#   openssl rand -base64 32
# Cadastre-o também em Project Settings > Environment Variables na Vercel.

POSTGRES_URL=
JWT_SECRET=
